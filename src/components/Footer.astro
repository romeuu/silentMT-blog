---
import { getLang } from "../utils/lang"

const pathname = Astro.url.pathname;
const language = getLang(pathname);
const otherLanguage = (language === 'es' ? 'en' : 'es');
const newPath = pathname.replace(`/${language}`, `/${otherLanguage}`);
---
<footer>
  {language === 'es' ? (
    <p>Inspiración tomada de <a href="https://bearblog.dev">Bear ʕ•ᴥ•ʔ</a></p>
    <a href={newPath} style="margin-right: 10px;">Cambiar a Inglés</a>
  ) : (
    <>
      <p>Inspired by <a href="https://bearblog.dev">Bear ʕ•ᴥ•ʔ</a></p>
      <a href={newPath} style="margin-right: 10px;">Switch to Spanish</a>
    </>
  )}
</footer>